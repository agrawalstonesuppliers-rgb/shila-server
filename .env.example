# Copy this file to .env for local testing.
# On Render, you'll enter these same values under "Environment" instead of a file.

# Comma-separated list of sites allowed to call this server
ALLOWED_ORIGINS=https://kotastone.co,https://www.kotastone.co

# From https://aistudio.google.com -> Get API Key (free, no card needed)
GEMINI_API_KEY=

# From your Supabase project -> Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Gmail address + App Password (NOT your normal Gmail password)
# Create one at https://myaccount.google.com/apppasswords
GMAIL_USER=agrawalstonesuppliers@gmail.com
GMAIL_APP_PASSWORD=
# Where lead notification emails should be sent (can be same as GMAIL_USER)
NOTIFY_EMAIL=agrawalstonesuppliers@gmail.com

# Optional: free WhatsApp alerts via CallMeBot (see README for setup)
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
